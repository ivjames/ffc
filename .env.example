# Frontend (Vite) build-time env. Copy to .env / .env.local and fill in.
# Only VITE_-prefixed vars are exposed to the client bundle.

# Base URL for the API. Empty = same origin (nginx proxies /api on the droplet).
VITE_API_BASE=

# Base URL for the CenterEdge POS adapter (src/lib/pos/centeredge.ts). Left
# empty in local dev it defaults to the local mock, http://localhost:8070 — run
# it with `npm run mock:centeredge` (see mock-centeredge/README.md). On the
# droplet, `ffc deploy` bakes in `/ce` (same-origin nginx proxy to the pm2
# mock) unless this is already set, so the food/rewards surfaces work against
# the mock in a deployed demo. Per-venue production endpoints are configured in
# Master Control (location.pos.apiBase), which overrides this. Note: with
# DEV_MODE on, every venue acts as if all POS capabilities are enabled (against
# this base); real venues are gated by their Master Control POS config.
VITE_CENTEREDGE_API_BASE=

# Dev mode. Gates development-only affordances: the skin picker (bottom-left),
# the build stamp (bottom-right), the scorecard/setup "Auto play (test)"
# buttons, and letting the scavenger-hunt photo picker offer the phone's photo
# library (upload a saved image) instead of forcing the live camera. Defaults
# on; set to 'false' for production so players must take a real photo.
# NOTE: the hunt upload also pairs with the server's HUNT_ALLOW_PHOTO_OF_PHOTO
# (see server/.env.example) if you want screenshots/photos-of-screens to verify.
VITE_DEV_MODE=

# On-location gate. When 'true', food, games, and golf are blocked unless the
# device is within a venue's geofence (GPS-confirmed). Opt-IN: any other value
# (including unset) leaves the requirement SUSPENDED so it never blocks testing
# or demos. Turn on per deployment once the venues' coords/geofenceKm are set in
# Master Control.
VITE_GEOFENCE_ENFORCED=
