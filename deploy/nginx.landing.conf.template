# nginx site for the Infinicade marketing landing page — the bare platform
# apex (lab980 convention: /etc/nginx/sites-available/<fqdn>-landing symlinked
# into sites-enabled/). Once this vhost exists, the player PWA serves only the
# org subdomains (*.<fqdn>) — `ffc landing-vhost` renders this file and then
# re-renders the player vhost apex-less in the same run.
#
# Placeholders to replace (ffc landing-vhost does this):
#   __FQDN__              e.g. ffc.lab980.com  (later: infinicade.com)
#   __APP_DIR__           e.g. /var/www/ffc
#   __WILDCARD_LINEAGE__  e.g. ffc-wildcard  (certbot lineage dir name)
#   __DEFAULT_ORG_HOST__  e.g. bullwinkles.ffc.lab980.com
#   __API_PORT__          e.g. 8068  (local API port, for /api/launch-signup)
#
# TLS: the wildcard lineage issued by `ffc wildcard-cert` covers the apex too,
# so this file references it directly. Certbot NEVER rewrites this file (same
# convention as nginx.admin.conf.template).

server {
    listen 80;
    listen [::]:80;
    server_name __FQDN__;
    # Redirect to HTTPS (the wildcard cert covers the apex).
    return 301 https://$host$request_uri;
}

server {
    # http2 belongs on the listen line for the nginx this box runs (1.24;
    # the per-server `http2 on;` directive arrives in 1.25.1, and is an
    # unknown directive before it). At the time of writing
    # most vhosts on the droplet carry the flag, and nginx keeps ONE set of
    # protocol options per :443 socket — so a vhost that omits it makes
    # nginx warn "protocol options redefined" for every vhost that disagrees.
    # This file is rewritten on every deploy, so omitting it here brought the
    # warnings back after each one. If the box moves to nginx >= 1.25.1 this
    # becomes `http2 on;` inside the block; `fix-nginx-http2` (lab980 repo)
    # audits and reports which form the box wants.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __FQDN__;

    # Wildcard cert covering *.<fqdn> AND the apex, issued via DNS-01.
    ssl_certificate     /etc/letsencrypt/live/__WILDCARD_LINEAGE__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__WILDCARD_LINEAGE__/privkey.pem;

    # Static landing page, shipped inside each release (build_release copies
    # landing/ next to dist/), so it swaps atomically with the app.
    root __APP_DIR__/current/landing;
    index index.html;

    # Frozen player paths baked into external artifacts — the printed QR
    # signage's /install, emailed /teams/accept, TV /tv, QR /join, shared-game
    # /games/:id/lobby, and account bookmarks under /me/ (see the REDIRECTS
    # note in src/App.tsx). The apex no longer serves the PWA, so forward them
    # (path + query intact) to the default org's subdomain.
    location = /install    { return 301 https://__DEFAULT_ORG_HOST__$request_uri; }
    location = /join       { return 301 https://__DEFAULT_ORG_HOST__$request_uri; }
    location = /tv         { return 301 https://__DEFAULT_ORG_HOST__$request_uri; }
    location /tv/          { return 301 https://__DEFAULT_ORG_HOST__$request_uri; }
    location /teams/accept { return 301 https://__DEFAULT_ORG_HOST__$request_uri; }
    location /games/       { return 301 https://__DEFAULT_ORG_HOST__$request_uri; }
    location /me/          { return 301 https://__DEFAULT_ORG_HOST__$request_uri; }

    # PWA self-destruct: installs from the apex-served-the-app era still poll
    # /sw.js for updates. Serve the kill-switch worker (landing/sw.js) uncached
    # so they unregister, drop their caches, and re-navigate into the 301s
    # above instead of replaying a dead cached shell.
    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Launch-signup capture — the ONE api path the marketing page calls,
    # proxied to the same local API as the player vhost. Deliberately an
    # exact match: the apex is a marketing surface, not the API surface, so
    # every other /api/* path stays static and falls through to try_files.
    location = /api/launch-signup {
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri /index.html;
    }
}
