#!/usr/bin/env bash
# ffc — operate CLI for the Mini Golf PWA (lab980 convention: each site ships
# bin/<name>). Symlink onto PATH once on the droplet:
#
#   ln -sf /var/www/ffc/bin/ffc /usr/local/bin/ffc
#
# Typical bring-up (after `provision-site ffc ivjames/ffc` clones the repo):
#   1. cd /var/www/ffc/server && cp .env.example .env   # set DATABASE_URL, APP_TOKEN
#   2. ffc setup                                          # everything else
# Routine updates thereafter:  ffc deploy
#
# Subcommands:
#   setup     one-time: static vhost + TLS, DB migrate, first build, seed
#   deploy    pull main -> test -> build atomically -> migrate -> swap ->
#             restart API -> health check (FFC_SKIP_TESTS=1 skips the gate)
#   rollback  [sha] return to the previously-deployed commit (code only —
#             schema migrations are forward-only and stay applied)
#   migrate   apply schema.sql (idempotent; new tables/columns)
#   version   show deployed client vs API build hash and whether they match
#   seed      (re)load the four courses into Postgres
#   restart   restart the pm2 API
#   logs      tail the pm2 API logs
#   backup    pg_dump -> data/backups/ (gzip, retention) + offsite push when
#             FFC_BACKUP_REMOTE is set (rclone remote or scp target)
#   backup-cron  install the nightly backup cron (/etc/cron.d/ffc-backup)
#   vhost     (re)write the player nginx vhost + (re)issue TLS
#   wildcard-cert  issue/renew the *.<fqdn> wildcard cert (certbot DNS-01 via doctl)
#   admin-vhost    (re)write the Master Control vhost (admin.<fqdn>)
#   admin-setup    one-time: wildcard-cert + admin-vhost (Master Control bring-up)
set -euo pipefail

# Resolve the app dir from this script's own location (…/ffc/bin/ffc -> …/ffc),
# so the stub (dir name) drives the FQDN by default: ffc -> ffc.lab980.com.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
APP_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
STUB="$(basename "$APP_DIR")"
FQDN="${FFC_FQDN:-$STUB.lab980.com}"          # override: FFC_FQDN=putt.example.com
# API port: single source of truth is the API's own config (server/.env PORT),
# then the port provision-site reserved (app-root .env), then 8060. The droplet
# runs many apps on 8060+, so NEVER assume 8060 — read what's configured.
# FFC_PORT overrides everything.
API_PORT="${FFC_PORT:-$(
  grep -hE '^[[:space:]]*(export[[:space:]]+)?PORT=' \
    "$APP_DIR/server/.env" "$APP_DIR/.env" 2>/dev/null | head -1 | grep -oE '[0-9]+' | head -1
)}"
: "${API_PORT:=8060}"
BRANCH="${FFC_BRANCH:-main}"
KEEP="${FFC_KEEP:-5}"                           # released builds to retain

# CenterEdge POS mock (mock-centeredge/) — a dev-only, in-memory stand-in for
# Advantage Web Services, run under pm2 and reached same-origin via the nginx
# /ce proxy so the food-ordering + rewards surfaces work in a deployed demo
# before real credentials land. CE_MOCK_BASE is baked into the client build as
# VITE_CENTEREDGE_API_BASE (only when the operator hasn't configured one — see
# build_release); the adapter appends /api/v1/… to it.
#
# Mock port: like API_PORT, read what's actually configured rather than assume a
# port on the shared 8060+ droplet — FFC_CE_PORT wins, else CE_MOCK_PORT from the
# app-root .env (where provision-site can reserve a free one), else 8070. mock_up
# hard-fails if it lands on the API port.
CE_MOCK_PORT="${FFC_CE_PORT:-$(
  grep -hE '^[[:space:]]*(export[[:space:]]+)?CE_MOCK_PORT=' \
    "$APP_DIR/.env" 2>/dev/null | head -1 | grep -oE '[0-9]+' | head -1 || true
)}"
: "${CE_MOCK_PORT:=8070}"
CE_MOCK_BASE="${FFC_CE_BASE:-/ce}"

# Master Control admin app: served on its own subdomain of the player FQDN,
# under a wildcard cert issued via DNS-01 (doctl). ADMIN_FQDN overridable.
ADMIN_FQDN="${FFC_ADMIN_FQDN:-admin.$FQDN}"     # e.g. admin.ffc.lab980.com
# The registered DNS zone doctl manages (last two labels of the FQDN).
BASE_DNS="${FFC_DNS_DOMAIN:-$(echo "$FQDN" | awk -F. '{print $(NF-1)"."$NF}')}"
# certbot lineage name for the wildcard cert (deterministic path under live/).
WILDCARD_CERT_NAME="${FFC_WILDCARD_CERT_NAME:-$STUB-wildcard}"

c_b=$'\033[1;34m'; c_r=$'\033[1;31m'; c_o=$'\033[0m'
log(){ printf '%s==>%s %s\n' "$c_b" "$c_o" "$*"; }
die(){ printf '%serror:%s %s\n' "$c_r" "$c_o" "$*" >&2; exit 1; }

# Install deps in $1. Prefer reproducible `npm ci` when a lockfile is present,
# fall back to `npm install` if one is missing (npm ci hard-fails without it).
# Quiet npm's noise (deprecation `npm warn`s, funding/audit nags) — we're not
# acting on them, so they're just clutter in the deploy readout. `--loglevel=error`
# keeps real failures visible; --no-fund/--no-audit drop the trailing nags.
NPM_QUIET=(--loglevel=error --no-fund --no-audit)
npm_install(){
  local dir="$1"; shift
  if [ -f "$dir/package-lock.json" ]; then ( cd "$dir" && npm ci "${NPM_QUIET[@]}" "$@" )
  else log "no lockfile in $dir — using npm install"; ( cd "$dir" && npm install "${NPM_QUIET[@]}" "$@" ); fi
}

# Build into a fresh release dir and swap the `current` symlink atomically
# (§3): never overwrite the served dir in place, or a mid-deploy load serves
# mixed old/new hashed assets and poisons the service-worker cache.
build_release(){
  local ts release
  ts="$(date +%Y%m%d%H%M%S)"
  release="$APP_DIR/releases/$ts"
  mkdir -p "$release"
  log "Building into $release"
  npm_install "$APP_DIR"
  # Point the client's CenterEdge adapter at the same-origin /ce proxy (see
  # mock_up + the nginx /ce block) — but ONLY when the operator hasn't already
  # configured a base. Vite gives a process env var precedence over its dotenv
  # files, so exporting our /ce default unconditionally would silently clobber a
  # real/sandbox VITE_CENTEREDGE_API_BASE set in .env / .env.local. So detect a
  # configured value (shell env, else a non-empty dotenv line) and, when present,
  # let Vite load it itself without an overriding process var.
  local ce_configured
  ce_configured="${VITE_CENTEREDGE_API_BASE:-$(
    grep -hE '^[[:space:]]*VITE_CENTEREDGE_API_BASE=.+' \
      "$APP_DIR/.env.local" "$APP_DIR/.env" 2>/dev/null | head -1 | cut -d= -f2- || true
  )}"
  if [ -n "$ce_configured" ]; then
    log "Using configured VITE_CENTEREDGE_API_BASE (not the /ce demo default)"
    ( cd "$APP_DIR" && npm run build )
  else
    ( cd "$APP_DIR" && VITE_CENTEREDGE_API_BASE="$CE_MOCK_BASE" npm run build )
  fi
  cp -r "$APP_DIR/dist" "$release/dist"
  # Master Control admin SPA — separate bundle (no service worker). Built and
  # shipped in the same atomic release so current/dist-admin swaps together with
  # the player build. Non-fatal if it fails: never block a player deploy on it.
  if ( cd "$APP_DIR" && npm run build:admin ); then
    cp -r "$APP_DIR/dist-admin" "$release/dist-admin"
  else
    log "admin build failed — shipping player build only this release"
  fi
  ln -sfn "$release" "$APP_DIR/current.tmp"
  mv -Tf "$APP_DIR/current.tmp" "$APP_DIR/current"
  log "current -> $ts"
  ls -1dt "$APP_DIR/releases"/*/ 2>/dev/null | tail -n +$((KEEP + 1)) | xargs -r rm -rf
}

# Install deps + (re)start the API under pm2. Start from server/ (--cwd) so
# dotenv loads server/.env (DATABASE_URL, APP_TOKEN).
api_up(){
  [ -d "$APP_DIR/server" ] || return 0
  npm_install "$APP_DIR/server" --omit=dev
  pm2 restart ffc-api --update-env \
    || pm2 start index.js --name ffc-api --cwd "$APP_DIR/server"
  pm2 save
}

# Install deps + (re)start the CenterEdge mock under pm2, bound to loopback on
# CE_MOCK_PORT (nginx's /ce proxy is the only entry). Card balances + history
# persist to $APP_DIR/data (MOCK_STATE_FILE) so a redeploy's restart no longer
# wipes them to the seed; the fake kitchen's orders stay ephemeral. Skips
# cleanly if the mock dir is ever absent.
mock_up(){
  [ -d "$APP_DIR/mock-centeredge" ] || return 0
  [ "$CE_MOCK_PORT" != "$API_PORT" ] \
    || die "CE_MOCK_PORT ($CE_MOCK_PORT) collides with the API port — reserve a free port via CE_MOCK_PORT in $APP_DIR/.env (or FFC_CE_PORT)"
  npm_install "$APP_DIR/mock-centeredge" --omit=dev
  PORT="$CE_MOCK_PORT" pm2 restart ffc-centeredge-mock --update-env \
    || PORT="$CE_MOCK_PORT" pm2 start index.js --name ffc-centeredge-mock --cwd "$APP_DIR/mock-centeredge"
  pm2 save
}

# Pre-deploy gate: run the server test suite (server/*.test.js, node:test)
# against a scratch database before anything ships. There is no CI on this
# project — the deploy IS the gate — so a red suite aborts with production
# untouched: no client swap, no migrate, no restart. The scratch DB is
# "<dbname>_test" on the same Postgres as DATABASE_URL (created on first
# use; FFC_TEST_DATABASE_URL overrides), and the suite's ensureSchema()
# applies schema.sql to it — so a broken migration also fails HERE, not
# against the live DB. Emergency bypass: FFC_SKIP_TESTS=1 ffc deploy.
run_server_tests(){
  [ -d "$APP_DIR/server" ] || return 0
  if [ -n "${FFC_SKIP_TESTS:-}" ]; then
    log "FFC_SKIP_TESTS set — SKIPPING the server test suite (emergency use only)"
    return 0
  fi
  local url test_url name
  url="$(grep -E '^DATABASE_URL=' "$APP_DIR/server/.env" 2>/dev/null | cut -d= -f2- || true)"
  [ -n "$url" ] || die "no DATABASE_URL in server/.env — cannot run the test gate (FFC_SKIP_TESTS=1 to bypass)"
  name="${url##*/}"; name="${name%%\?*}"
  test_url="${FFC_TEST_DATABASE_URL:-${url%/*}/${name}_test}"
  # Create the scratch DB on first use; harmless if it already exists.
  command -v psql >/dev/null || die "psql not found — needed for the test gate (FFC_SKIP_TESTS=1 to bypass)"
  psql "${url%/*}/postgres" -qc "create database \"${name}_test\"" >/dev/null 2>&1 || true
  psql "$test_url" -qc "select 1" >/dev/null 2>&1 \
    || die "cannot reach test database $test_url — create it, or set FFC_TEST_DATABASE_URL (FFC_SKIP_TESTS=1 to bypass)"
  log "Test gate: running server suite against ${test_url##*/} (red aborts the deploy)"
  npm_install "$APP_DIR/server" --omit=dev
  ( cd "$APP_DIR/server" && TEST_DATABASE_URL="$test_url" npm test ) \
    || die "server tests FAILED — deploy aborted before build/migrate/restart. Fix forward, or FFC_SKIP_TESTS=1 for a true emergency."
  log "Test gate green."
}

# Post-restart health gate: poll /api/health until the API answers (pm2
# reports "restarted" even for a process that immediately crash-loops, so
# the restart alone proves nothing). ~30s budget covers a slow cold boot.
api_health(){
  local i
  for i in $(seq 1 15); do
    if curl -fsS "http://127.0.0.1:$API_PORT/api/health" >/dev/null 2>&1; then
      log "API healthy on :$API_PORT"
      return 0
    fi
    sleep 2
  done
  return 1
}

cmd_vhost(){
  [ -f "$APP_DIR/deploy/nginx.conf.template" ] || die "missing deploy/nginx.conf.template"
  local conf="/etc/nginx/sites-available/$FQDN"
  log "Writing static vhost $conf (root current/dist, /api -> :$API_PORT, /ce -> :$CE_MOCK_PORT)"
  sed -e "s/__FQDN__/$FQDN/g" -e "s#__APP_DIR__#$APP_DIR#g" -e "s/__API_PORT__/$API_PORT/g" \
    -e "s/__CE_MOCK_PORT__/$CE_MOCK_PORT/g" \
    "$APP_DIR/deploy/nginx.conf.template" > "$conf"
  ln -sf "$conf" "/etc/nginx/sites-enabled/$FQDN"
  nginx -t && systemctl reload nginx
  if command -v certbot >/dev/null; then
    log "Issuing/refreshing TLS for $FQDN"
    certbot --nginx -d "$FQDN" --redirect -n --agree-tos \
      -m "${CERTBOT_EMAIL:-ivjames@gmail.com}" \
      || log "certbot did not complete (DNS still propagating?). Re-run later: ffc vhost"
  else
    log "certbot not found — install it, then: ffc vhost"
  fi
}

# Apply schema.sql. All DDL is idempotent (create ... if not exists, on conflict
# do nothing), so it's safe to run on every deploy — that's how new tables and
# columns reach production without a manual step.
cmd_migrate(){
  [ -d "$APP_DIR/server" ] || return 0
  log "Migrating database (idempotent)"
  npm_install "$APP_DIR/server" --omit=dev
  ( cd "$APP_DIR/server" && npm run migrate )
}

# Report the deployed client build (from the served version.json) and the live
# API build (from /api/health), and whether they match. Reads local files/port
# so it works before TLS/DNS are in play.
cmd_version(){
  local client api
  client="$(grep -oE '"build":"[^"]+"' "$APP_DIR/current/dist/version.json" 2>/dev/null | cut -d'"' -f4)"
  api="$(curl -fsS "http://127.0.0.1:$API_PORT/api/health" 2>/dev/null | grep -oE '"build":"[^"]+"' | cut -d'"' -f4)"
  log "client build: ${client:-unknown}"
  log "api build:    ${api:-unknown}"
  if [ -n "$client" ] && [ "$client" = "$api" ]; then
    log "client and API in sync ($client)"
  else
    log "build MISMATCH (client=${client:-?} api=${api:-?}) — API may need a restart, or a browser is on a cached bundle"
  fi
}

cmd_seed(){
  local token
  token="$(grep -E '^APP_TOKEN=' "$APP_DIR/server/.env" 2>/dev/null | cut -d= -f2- || true)"
  log "Seeding courses -> 127.0.0.1:$API_PORT/api/seed"
  curl -fsS -X POST "http://127.0.0.1:$API_PORT/api/seed" \
    -H 'content-type: application/json' \
    ${token:+-H "x-app-token: $token"} \
    --data-binary @"$APP_DIR/deploy/courses.seed.json" >/dev/null
  log "Seeded 4 courses."
}

cmd_deploy(){
  cd "$APP_DIR"
  # Pull first, then re-exec the freshly-pulled copy of THIS script so that any
  # changes to the deploy logic itself take effect on the same run — otherwise
  # every deploy-script change lands one deploy late (the running process is the
  # pre-pull version). FFC_REEXEC guards against an infinite re-exec loop.
  if [ -z "${FFC_REEXEC:-}" ]; then
    log "Fetching origin/$BRANCH"
    local before after
    before="$(git rev-parse HEAD 2>/dev/null || true)"
    git fetch --quiet origin "$BRANCH"
    git checkout --quiet "$BRANCH"
    git reset --hard --quiet "origin/$BRANCH"
    after="$(git rev-parse HEAD 2>/dev/null || true)"
    # Readout of what this deploy is actually shipping: the files that changed
    # between the previously-deployed commit and the freshly-pulled HEAD, so you
    # can see at a glance what moved while watching the deploy. The outgoing
    # SHA is recorded (untracked file, survives reset --hard) so `ffc rollback`
    # has a target if this deploy goes bad.
    if [ -n "$before" ] && [ "$before" != "$after" ]; then
      printf '%s\n' "$before" > "$APP_DIR/.ffc-prev-sha"
      log "Changes since ${before:0:7} -> ${after:0:7}:"
      git --no-pager diff --stat "$before" "$after"
    elif [ "$before" = "$after" ]; then
      log "Already up to date (${after:0:7}) — nothing new to pull."
    fi
    log "Re-exec updated deploy script"
    FFC_REEXEC=1 exec "$SELF" deploy
  fi
  # Past this point we are running the up-to-date script (post-pull).
  run_server_tests      # the gate: red aborts with production untouched
  build_release
  cmd_migrate           # apply any new schema before the new code serves
  api_up
  if ! api_health; then
    log "API FAILED its health check after restart — recent logs:"
    pm2 logs ffc-api --lines 30 --nostream || true
    die "deploy is NOT healthy. Roll back with: ffc rollback  (target: $(cat "$APP_DIR/.ffc-prev-sha" 2>/dev/null || echo 'unknown — pass a sha'))"
  fi
  mock_up               # (re)start the CenterEdge mock behind the /ce proxy
  # Ensure the live vhost carries current nginx directives (e.g. the photo-upload
  # client_max_body_size). Re-rendering re-runs certbot, so only do it when the
  # directive is actually missing — otherwise just reload. Self-heals the "you
  # also had to run ffc vhost" gap without touching TLS on every deploy.
  local conf="/etc/nginx/sites-available/$FQDN"
  if [ -f "$conf" ] && ! grep -q 'client_max_body_size' "$conf"; then
    log "vhost missing client_max_body_size — re-rendering (runs certbot once)"
    cmd_vhost
  elif [ -f "$conf" ] && ! grep -q 'location /ce/' "$conf"; then
    log "vhost missing /ce proxy — re-rendering (runs certbot once)"
    cmd_vhost
  else
    nginx -t && systemctl reload nginx
  fi
  log "Deployed $STUB -> https://$FQDN"
  cmd_version           # report client/API build sync

}

cmd_setup(){
  [ "$(id -u)" -eq 0 ] || die "run as root (writes nginx + runs certbot)."
  [ -f "$APP_DIR/server/.env" ] \
    || die "create $APP_DIR/server/.env first (DATABASE_URL, PORT, APP_TOKEN) — see server/.env.example"
  cmd_migrate
  api_up
  mock_up
  build_release
  cmd_vhost
  sleep 1   # let the API bind before seeding
  cmd_seed || log "seed skipped — run 'ffc seed' once the API + DB are ready"
  log "Setup complete: https://$FQDN"
}

# Issue/renew the wildcard TLS cert (*.FQDN + FQDN) via certbot DNS-01, backed
# by the droplet's existing doctl auth (no plugin, no credentials file). The
# _acme-challenge TXT records are written/removed by deploy/acme-doctl-*.sh.
cmd_wildcard_cert(){
  command -v certbot >/dev/null || die "certbot not found"
  command -v doctl   >/dev/null || die "doctl not found (needed for DNS-01)"
  doctl compute domain records list "$BASE_DNS" >/dev/null 2>&1 \
    || die "doctl can't read DNS zone '$BASE_DNS' — is doctl authenticated with a token that has write scope for it?"
  local auth="$APP_DIR/deploy/acme-doctl-auth.sh"
  local cleanup="$APP_DIR/deploy/acme-doctl-cleanup.sh"
  chmod +x "$auth" "$cleanup" 2>/dev/null || true
  log "Issuing/renewing wildcard cert '$WILDCARD_CERT_NAME' for *.$FQDN + $FQDN (DNS-01 via doctl, zone $BASE_DNS)"
  FFC_DNS_DOMAIN="$BASE_DNS" certbot certonly \
    --manual --preferred-challenges dns \
    --manual-auth-hook "$auth" \
    --manual-cleanup-hook "$cleanup" \
    --cert-name "$WILDCARD_CERT_NAME" \
    -d "*.$FQDN" -d "$FQDN" \
    -n --agree-tos -m "${CERTBOT_EMAIL:-ivjames@gmail.com}"
  log "Wildcard cert ready: /etc/letsencrypt/live/$WILDCARD_CERT_NAME/"
}

# (Re)write the admin vhost (admin.<fqdn>) and reload nginx. Requires the
# wildcard cert to exist first (the vhost references it directly — certbot does
# NOT rewrite this file per-host the way the player vhost is handled).
cmd_admin_vhost(){
  [ -f "$APP_DIR/deploy/nginx.admin.conf.template" ] || die "missing deploy/nginx.admin.conf.template"
  [ -d "/etc/letsencrypt/live/$WILDCARD_CERT_NAME" ] \
    || die "wildcard cert '$WILDCARD_CERT_NAME' not found — run 'ffc wildcard-cert' first"
  local conf="/etc/nginx/sites-available/$ADMIN_FQDN"
  log "Writing admin vhost $conf (root current/dist-admin, /api -> :$API_PORT)"
  sed -e "s/__ADMIN_FQDN__/$ADMIN_FQDN/g" \
      -e "s#__APP_DIR__#$APP_DIR#g" \
      -e "s/__API_PORT__/$API_PORT/g" \
      -e "s/__WILDCARD_LINEAGE__/$WILDCARD_CERT_NAME/g" \
      "$APP_DIR/deploy/nginx.admin.conf.template" > "$conf"
  ln -sf "$conf" "/etc/nginx/sites-enabled/$ADMIN_FQDN"
  nginx -t && systemctl reload nginx
  log "Master Control: https://$ADMIN_FQDN"
}

# One-shot admin bring-up: wildcard cert + admin vhost. Run once after `setup`.
cmd_admin_setup(){
  [ "$(id -u)" -eq 0 ] || die "run as root (writes nginx + runs certbot)."
  cmd_wildcard_cert
  cmd_admin_vhost
}

# Return to the previously-deployed commit (recorded by cmd_deploy), or an
# explicit one: ffc rollback [sha]. CODE ONLY — schema.sql is forward-only
# and already-applied DDL stays applied; the recorded SHA was serving against
# this schema minutes ago, and additive-only migrations (the house rule) keep
# old code compatible. Skips the test gate (this code already passed it when
# it deployed) and skips migrate. The next `ffc deploy` returns to the tip.
cmd_rollback(){
  cd "$APP_DIR"
  local target="${1:-$(cat "$APP_DIR/.ffc-prev-sha" 2>/dev/null || true)}"
  [ -n "$target" ] || die "no previous deploy recorded — pass a commit: ffc rollback <sha>"
  git rev-parse --verify --quiet "$target^{commit}" >/dev/null \
    || { git fetch --quiet origin "$BRANCH" || true
         git rev-parse --verify --quiet "$target^{commit}" >/dev/null \
           || die "unknown commit: $target"; }
  log "Rolling back to ${target:0:12} (code only — applied schema stays)"
  git reset --hard --quiet "$target"
  build_release
  api_up
  if ! api_health; then
    pm2 logs ffc-api --lines 30 --nostream || true
    die "API still unhealthy after rollback — inspect: ffc logs"
  fi
  mock_up
  cmd_version
  log "Rolled back. NOTE: the next 'ffc deploy' ships origin/$BRANCH tip again."
}

# pg_dump -> data/backups/ (gzipped, newest FFC_BACKUP_KEEP kept locally,
# default 14) and then OFFSITE: the local disk is the same failure domain as
# Postgres itself, so a dump that never leaves the droplet is a convenience,
# not a backup. Configure FFC_BACKUP_REMOTE (env or app-root .env) as either
# an rclone remote path ("spaces:ffc-backups" — for DO Spaces etc.) or an
# scp target ("user@host:/backups/ffc"). Restore: gunzip -c dump.sql.gz |
# psql "$DATABASE_URL" into a FRESH database.
cmd_backup(){
  local url out keep remote
  url="$(grep -E '^DATABASE_URL=' "$APP_DIR/server/.env" 2>/dev/null | cut -d= -f2- || true)"
  [ -n "$url" ] || die "no DATABASE_URL in server/.env"
  mkdir -p "$APP_DIR/data/backups"
  out="$APP_DIR/data/backups/ffc-$(date +%Y%m%d%H%M%S).sql.gz"
  log "Dumping database -> $out"
  pg_dump "$url" | gzip > "$out"
  log "Backup written ($(du -h "$out" | cut -f1))."
  keep="${FFC_BACKUP_KEEP:-14}"
  ls -1t "$APP_DIR/data/backups"/ffc-*.sql.gz 2>/dev/null | tail -n +$((keep + 1)) | xargs -r rm -f
  remote="${FFC_BACKUP_REMOTE:-$(
    grep -hE '^FFC_BACKUP_REMOTE=' "$APP_DIR/.env" 2>/dev/null | head -1 | cut -d= -f2- || true
  )}"
  if [ -z "$remote" ]; then
    log "WARNING: no FFC_BACKUP_REMOTE configured — this dump lives on the SAME droplet as the database (droplet loss = total data loss). Set FFC_BACKUP_REMOTE in $APP_DIR/.env and re-run."
    return 0
  fi
  if command -v rclone >/dev/null && rclone listremotes 2>/dev/null | grep -q "^${remote%%:*}:$"; then
    log "Pushing offsite via rclone -> $remote"
    rclone copy "$out" "$remote" --no-traverse
  elif [[ "$remote" == *@*:* ]]; then
    log "Pushing offsite via scp -> $remote"
    scp -q "$out" "$remote"
  else
    die "FFC_BACKUP_REMOTE='$remote' is neither a configured rclone remote nor an scp user@host:path target"
  fi
  log "Offsite copy complete."
}

# Install the nightly backup cron (root, /etc/cron.d). FFC_BACKUP_CRON
# overrides the schedule (default 04:10 server-local, after the day's play).
cmd_backup_cron(){
  [ "$(id -u)" -eq 0 ] || die "run as root (writes /etc/cron.d)"
  local when="${FFC_BACKUP_CRON:-10 4 * * *}"
  printf '# ffc nightly DB backup (installed by: ffc backup-cron)\n%s root %s backup >> /var/log/ffc-backup.log 2>&1\n' \
    "$when" "$SELF" > /etc/cron.d/ffc-backup
  chmod 644 /etc/cron.d/ffc-backup
  log "Installed /etc/cron.d/ffc-backup ($when). Log: /var/log/ffc-backup.log"
  local remote
  remote="$(grep -hE '^FFC_BACKUP_REMOTE=' "$APP_DIR/.env" 2>/dev/null | head -1 | cut -d= -f2- || true)"
  [ -n "${FFC_BACKUP_REMOTE:-$remote}" ] \
    || log "WARNING: FFC_BACKUP_REMOTE is not set — nightly dumps will stay ON this droplet. Set it in $APP_DIR/.env for real (offsite) backups."
}

case "${1:-}" in
  setup)            cmd_setup ;;
  deploy|redeploy)  cmd_deploy ;;
  rollback)         shift; cmd_rollback "$@" ;;
  migrate)          cmd_migrate ;;
  version)          cmd_version ;;
  vhost)            cmd_vhost ;;
  seed)             cmd_seed ;;
  restart)          pm2 restart ffc-api && pm2 save ;;
  logs)             pm2 logs ffc-api ;;
  backup)           cmd_backup ;;
  backup-cron)      cmd_backup_cron ;;
  wildcard-cert)    cmd_wildcard_cert ;;
  admin-vhost)      cmd_admin_vhost ;;
  admin-setup)      cmd_admin_setup ;;
  ''|-h|--help)
    awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$SELF"
    ;;
  *) die "unknown command: $1 (run 'ffc --help')" ;;
esac
