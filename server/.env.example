# Copy to .env and fill in. .env stays local to this app dir (lab980 convention).
DATABASE_URL=postgres://user:pass@localhost:5432/ffc
# Local port the API listens on. The droplet runs many apps on 8060+, so use the
# FREE port provision-site reserved for this site:  grep '^PORT=' ../.env
# (bin/ffc reads this PORT for the nginx vhost, health check, and seeding).
PORT=8060
# Shared token guarding POST /api/seed, POST /api/locations, and all of
# /api/admin/*. REQUIRED — if unset, those routes fail closed (401 on every
# request, including on a local dev box). Set this before using any of them.
# On /api/admin/* it also doubles as the bootstrap credential: use it to call
# POST /api/admin/users once and create the first real admin_user login
# (server/README.md's "Admin accounts & sessions") — after that, admin_user
# sessions work alongside it, not instead of it.
APP_TOKEN=
# development | production. Affects two things: admin session cookies (set
# `Secure`, HTTPS-only, when production) and HUNT_ALLOW_PHOTO_OF_PHOTO below
# (forced off when production, regardless of its own value). Leave unset for
# local dev; the droplet's deploy sets it to production.
NODE_ENV=
# Fallback timezone for the leaderboard's calendar windows (day/week/month are
# tracked by calendar date, not a rolling 24h/7d/30d). The real zone is per venue
# (location.tz in the DB), so venues in different regions each use their own
# calendar day; this VENUE_TZ is only the default for a venue with no tz set.
VENUE_TZ=America/Los_Angeles
# Scavenger hunt: max vision (model) calls per round — the hard ceiling on API
# spend per group. Dedup short-circuits don't count (no model call). Unset =
# default 240, the legitimate max (4 players x 20 items max x 3 attempts;
# ~$0.50 full-burn on Haiku 4.5) — the per-item attempt cap below is the
# working spend control, this is the backstop that also bounds countable-item
# grinding. 0 = kill switch (every verify 429s). Read per request — no restart
# needed, so it can be tightened live if a venue wants a lower ceiling.
HUNT_SCAN_CAP=
# Max judged shots a player gets at one non-countable item per round (a
# successful find dedupes anyway, so this bounds failed attempts; "couldn't
# read that photo" retries don't count). Countable items are exempt — the
# round cap above still bounds them. Unset = default 3. Read per request.
HUNT_ATTEMPT_CAP=
# Privacy: how many days a stored hunt photo lives before the retention sweep
# deletes it from disk (the find row — who found what, when — is kept, just
# with no image). Unset = default 30. 0 (or negative) disables the sweep —
# an explicit operator opt-out, meaning photos are kept until an admin removes
# them by hand in Master Control -> Photos. The app's /privacy page reads this
# value live (GET /api/hunt/photo-retention), so the player-facing disclosure
# tracks whatever is set here automatically — including the disabled case.
HUNT_PHOTO_RETENTION_DAYS=
# Photo booth (routes/photos.js — the AI-free sharing + stickers pipeline).
# Same retention semantics as the hunt: days a stored booth photo lives before
# the sweep deletes it (file AND row — booth rows carry no credit worth
# keeping). Unset = default 30; 0 (or negative) disables the sweep. /privacy
# reads this live via GET /api/photos/retention.
PHOTO_BOOTH_RETENTION_DAYS=
# Max photos one device (booth id) can have stored at a time — a fairness cap.
# 429 past it until the player deletes some or retention ages them out. Unset =
# default 100. 0 = kill switch for new uploads. Read per request — no restart
# needed.
PHOTO_BOOTH_CAP=
# Directory for venue-uploaded booth sticker SVGs (Master Control → Booth
# stickers). Unset = ./data/booth-stickers under the server dir; set to a
# durable volume in production. Uploads are validated (lib/svgSanitize.js) and
# served inert (locked-down CSP), never inlined.
PHOTO_BOOTH_STICKER_DIR=
# The REAL disk bound: total megabytes of stored booth photos across all
# booths (booth ids are client-chosen, so the per-booth cap can't bound disk
# by itself). Uploads 429 once the budget is spent, until retention or deletes
# free room. Unset = default 10240 (10 GB). 0 = kill switch for new uploads.
# Read per request — no restart needed.
PHOTO_BOOTH_DISK_BUDGET_MB=

# --- Reviewer commentary (in-app feedback widget) ---
# Total megabytes of stored feedback screenshots. Past the budget a note still
# files — only its screenshot is dropped (the response says so), because
# losing a reviewer's words to an image quota is the wrong failure. Unset =
# default 1024 (1 GB). 0 = comments only, no new screenshots stored. Read per
# request — no restart needed.
FEEDBACK_DISK_BUDGET_MB=

# --- Synthetic (bot) rounds — load/soak + smoke + demo seeding ---
# The course-bot (scripts/course-bot.mjs) POSTs rounds with `synthetic: true`
# through the real /api/rounds path. Marking a round synthetic is an operator
# capability, not something any device may self-assert: the bot must send this
# shared secret as the `x-synthetic-key` header, and the server rejects any
# `synthetic: true` whose header doesn't match. UNSET = feature OFF (every
# synthetic round is 403'd) — so production is opt-in. Every synthetic round is
# flagged in the DB and carries a `synthetic:<runId>:<uuid>` client_id, so a run
# is bulk-deletable: `delete from round where synthetic;` (cascades score +
# reward_grant). Read per request — no restart to enable/rotate.
SYNTHETIC_BOT_KEY=
# Do synthetic rounds mint reward grants (loyalty-card tickets)? Default true so
# testing exercises the full reward path. Set false so a bot run never dispenses
# real tickets. Real rounds are never affected. Read per request.
SYNTHETIC_MINT_REWARDS=
# Do synthetic rounds count on leaderboards + admin rollups? Default true. Set
# false to exclude bot rounds from every board/report while still writing them
# (useful for pure load testing without visibly polluting boards). Real rounds
# are never affected. Read per request.
SYNTHETIC_COUNT_ON_BOARD=

# --- TESTING TOGGLES (remove/leave unset before production) ---
# TEST ONLY — must not be set in production. Bypasses the scavenger-hunt
# anti-cheat so a screenshot or a picture of a screen still verifies a
# landmark. Truthy (1/true/yes/on) enables it. Leave UNSET in production to
# keep the photo-of-a-photo check active; if NODE_ENV=production and this is
# still set truthy, the server forces it off itself and logs a warning.
HUNT_ALLOW_PHOTO_OF_PHOTO=

# --- Player accounts & shared games ---
# Outbound email for sign-in codes + team invites: console | resend | smtp.
# console (default) logs the full message — including the 6-digit code — to
# stdout; the server warns at startup if production is still on console.
# UNSET/console ALSO enables sign-in BYPASS mode: request-code returns the
# code in its response and the app signs in with no email round-trip (the
# stopgap until Resend is wired up — email ownership is NOT verified while
# it's on). Setting a real provider retires the bypass, no restart needed.
# resend needs RESEND_API_KEY (and a Resend-verified sending domain: SPF/DKIM).
# smtp needs SMTP_URL and a manual `npm i nodemailer` (not a package dep).
MAIL_PROVIDER=
MAIL_FROM=
RESEND_API_KEY=
SMTP_URL=
# Max outbound emails per rolling 24h, all kinds, metered in mail_send
# (the HUNT_SCAN_CAP precedent applied to email spend). Unset = default 500.
MAIL_DAILY_CAP=
# Public origin of the player PWA — base URL for magic-link redirects and
# team-invite links. Unset = default http://localhost:5173 (local dev).
PUBLIC_APP_URL=

# --- Vision / model provider keys ---
# REQUIRED for the scavenger hunt: every /api/hunt/verify judges the photo
# with an Anthropic vision call (lib/vision.js). Unset = the hunt feature
# reports itself unavailable (no verifies). Also the key behind the hunt-item
# vetting screen and the vision bench's Anthropic rows
# (routes/admin/visionBakeoff.js). This is the droplet's single biggest
# recurring spend knob — caps above (HUNT_SCAN_CAP etc.) meter it.
ANTHROPIC_API_KEY=
# Optional second provider for the vision bench + the people-screen
# descriptor (scripts/lib/vision-compare-core.mjs). Unset = those rows show
# "not configured"; the hunt itself never needs it.
GEMINI_API_KEY=

# --- Real CenterEdge credentials (POS loyalty crediting) ---
# UNSET = the server credits the local CenterEdge mock on loopback (port from
# FFC_CE_PORT / CE_MOCK_PORT, else 8070 — bin/ffc mock_up), which is the
# pre-credential deployed state. When real Advantage Web Services credentials
# land, set both and ticket awards credit the real vendor with NO code
# change (lib/posLoyalty.js). SECURITY: these live only here in server env —
# never in the org-admin-writable pos config (see posLoyalty.js's note on
# token exfiltration).
CENTEREDGE_API_BASE=
CENTEREDGE_API_TOKEN=

# --- Paths & misc (all have sensible defaults; set for durable volumes) ---
# Where verified hunt photos are stored. Unset = ./data/hunt-uploads under
# the server dir. The retention sweep (HUNT_PHOTO_RETENTION_DAYS above)
# deletes from here.
HUNT_UPLOAD_DIR=
# Where hunt-item vetting images (Master Control -> Hunt) are stored.
# Unset = ./data/hunt-item-images under the server dir.
HUNT_ITEM_IMAGE_DIR=
# Where photo-booth photos are stored. Unset = ./data/booth-photos under the
# server dir (stickers dir is PHOTO_BOOTH_STICKER_DIR above).
PHOTO_BOOTH_DIR=
# Where reviewer-feedback screenshots are stored. Unset = ./data/feedback-shots
# under the server dir. Bounded by FEEDBACK_DISK_BUDGET_MB above.
FEEDBACK_DIR=
# Vision-bench disk store (dataset images + run history for
# /api/admin/vision-bakeoff). Unset = ./bakeoff-data under the server dir.
BAKEOFF_DATA_DIR=
# Timezone for Master Control's reporting date buckets + CSV export windows
# (routes/admin/overview.js, export.js). Per-venue calendars use each
# location's own tz; this is just the admin reporting frame. Unset =
# America/Los_Angeles.
ADMIN_TZ=
# Build stamp reported by /api/health (client/API sync check — ffc version).
# Unset = the API resolves `git rev-parse --short HEAD` itself at startup,
# which is right on the droplet; set only if deploying without a git checkout.
BUILD_ID=
